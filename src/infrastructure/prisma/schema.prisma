// ─────────────────────────────────────────────────────────────────────────────
// Clean Architecture API template — data model
//
// TENANCY
//   Every tenant-owned table carries a NOT NULL `tenantId`. This is true in
//   BOTH tenancy modes: a single-tenant deployment simply has exactly one
//   Tenant row (seeded at bootstrap) that everything points at. Nothing in the
//   domain, application or repository layer branches on the mode — only tenant
//   *resolution* differs. That is what makes single -> multi a data migration
//   instead of a rewrite.
//
//   Scoping is enforced at runtime by a Prisma client extension
//   (see prisma.client.ts), not by discipline. A repository that forgets
//   `tenantId` still cannot read across tenants.
//
// SOFT DELETES
//   Tenant, Branch, User and Employee carry `deletedAt`. Repository read paths
//   filter it explicitly (no hidden magic) — see PrismaBaseRepository.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  // Operates across every tenant. Lives in the reserved system tenant.
  PlatformAdmin
  // Full control within one tenant.
  TenantAdmin
  // Scoped to the branches they manage.
  BranchManager
  // Ordinary authenticated user.
  Member
}

enum UserType {
  Employee
  Customer
}

enum CredentialChangeReason {
  Email
  Password
  AdminReset
}

// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  // Stable, URL-safe identifier. In single-tenant mode this is
  // DEFAULT_TENANT_SLUG; the reserved platform tenant uses "__platform__".
  slug      String    @unique
  name      String
  // True only for the reserved tenant that holds PlatformAdmin accounts.
  // Guarded so it can never be deleted or listed as a customer tenant.
  isSystem  Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users               User[]
  employees           Employee[]
  branches            Branch[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@index([isActive])
  @@index([deletedAt])
}

model Branch {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String
  // Human-readable short code, unique inside the tenant.
  code        String?
  description String?
  street      String?
  city        String?
  state       String?
  zipCode     String?
  country     String?
  phoneNumber String?
  email       String?
  mapsUrl     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([deletedAt])
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  firstName String
  lastName  String
  // Globally unique: login is a single lookup that resolves the tenant from
  // the user. If you ever need the same person in two tenants, this becomes
  // @@unique([tenantId, email]) and login must be tenant-scoped.
  email       String @unique
  phoneNumber String @unique

  passwordHash String
  roles        UserRole[]
  userType     UserType   @default(Employee)

  isActive           Boolean @default(true)
  // Forces a password change on next authenticated request.
  mustChangePassword Boolean @default(false)

  // Any access token issued at or before this instant is rejected. Replaces
  // the "isCredentialUpdated" boolean flag pattern: no write on login is
  // needed, and the check is a pure timestamp comparison against the JWT iat.
  credentialsChangedAt DateTime?
  credentialsChangedFor CredentialChangeReason?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee            Employee?
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, userType])
  @@index([deletedAt])
}

model Employee {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId   String @unique @db.Uuid
  // Nullable by design: an employee may exist before a branch is assigned,
  // and products with BRANCHES_ENABLED=false never set it.
  branchId String? @db.Uuid

  employeeNumber String?
  jobTitle       String?
  hireDate       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([deletedAt])
}

// One row per active login. Replaces the single refreshTokenHash column so
// that multi-device login works and a single session can be revoked.
model Session {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId   String @db.Uuid

  // SHA-256 of the opaque refresh token. The plaintext never touches the DB.
  refreshTokenHash String @unique
  // All rotations of one login share a familyId. Presenting an already-rotated
  // token revokes the entire family — that is the reuse-detection signal.
  familyId         String @db.Uuid

  userAgent String?
  ipAddress String?

  expiresAt   DateTime
  // Set when rotated or explicitly revoked. A session is valid only while
  // revokedAt is null and expiresAt is in the future.
  revokedAt   DateTime?
  revokedReason String?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId   String @db.Uuid

  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
}
