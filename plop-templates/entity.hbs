import { Guard } from "../validation";

export interface {{pascalCase name}}Props {
    id: string;
    tenantId: string;
    name: string;
    isActive: boolean;
    createdAt: Date;
    updatedAt: Date;
    deletedAt: Date | null;
}

export interface Create{{pascalCase name}}Input {
