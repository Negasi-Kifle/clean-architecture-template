# ─────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public
# Used only by `npm run test:int`. Integration tests are skipped when unset.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app_test?schema=public

# ─────────────────────────────────────────────────────────────
# Feature flags — these decide the shape of the product
# ─────────────────────────────────────────────────────────────
# single = one implicit tenant, seeded at bootstrap, resolved automatically.
# multi  = tenant is resolved from the authenticated session's JWT claim.
# The database schema is IDENTICAL in both modes. Switching single -> multi
# later is a config change plus a data migration, never a rewrite.
TENANCY_MODE=single

# Slug of the tenant every request resolves to when TENANCY_MODE=single.
DEFAULT_TENANT_SLUG=default

# When false, the /branches routes are not mounted. branchId stays nullable
# on Employee either way, so turning this on later needs no migration.
BRANCHES_ENABLED=true

# ─────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=clean-architecture-api
JWT_AUDIENCE=clean-architecture-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=1800
PASSWORD_MIN_LENGTH=8
BCRYPT_COST=12
# Optional. When set, employees created by an admin get this initial password
# and are forced to change it. When unset, a random one is generated and
# returned once in the create response.
DEFAULT_EMPLOYEE_PASSWORD=

# ─────────────────────────────────────────────────────────────
# HTTP
# ─────────────────────────────────────────────────────────────
# Comma-separated allowlist. "*" allows everything (development only).
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ─────────────────────────────────────────────────────────────
# Bootstrap (seed only)
# ─────────────────────────────────────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_PHONE=0900000000

# ─────────────────────────────────────────────────────────────
# Email (password reset). Unset SMTP_HOST to log links instead of sending.
# ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Example App
CLIENT_URL=http://localhost:5173
